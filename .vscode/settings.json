{
	"json.schemas": [
		{
			"fileMatch": [
				"/static/greedy.json",
			],
			"url": "./schemas/script-schema.json"
		},
		{
			"fileMatch": [
				"/static/roles.json",
				"/static/greedier/*.json",
			],
			"url": "./schemas/roles-schema.json"
		},
		{
			"fileMatch": [
				"/static/greedy_jinxes.json",
				"/static/jinxes.json",
			],
			"url": "./schemas/jinx-schema.json"
		}
	],
	"[python]": {
		"editor.defaultFormatter": "ms-python.black-formatter",
		"editor.formatOnSave": true
	},
	"black-formatter.importStrategy": "fromEnvironment"
}
