{
  "name": "greedywhalebuffet",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "start": "parcel",
    "build": "parcel build",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:data-sources": "vitest run src/data.schema-validation.test.ts src/data.jinx-order.test.ts src/data.manifest.test.ts",
    "test:unit": "vitest run --exclude src/data.schema-validation.test.ts --exclude src/e2e.schema-validation.test.ts",
    "test:e2e": "vitest run src/e2e.schema-validation.test.ts",
    "test:watch": "vitest"
  },
  "staticFiles": {
    "staticPath": "static",
    "staticOutPath": "."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
