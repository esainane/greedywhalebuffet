{
  "name": "parcel-vanilla-starter",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "source": "src/index.html",
  "scripts": {
    "start": "parcel",
    "build": "parcel build",
    "lint": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:data-sources": "vitest run src/data-source-validation.test.ts",
    "test:unit": "vitest run --exclude src/data-source-validation.test.ts --exclude src/e2e.schema-validation.test.ts",
    "test:e2e": "vitest run src/e2e.schema-validation.test.ts",
    "test:watch": "vitest"
  },
  "staticFiles": {
    "staticPath": "static",
    "staticOutPath": "."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-plugin-jsdoc": "^63.2.0",
    "globals": "^17.7.0",
    "parcel": "^2.16.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
